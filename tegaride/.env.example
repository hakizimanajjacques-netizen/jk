# ---- General ----
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# ---- PostgreSQL (used by docker-compose.yml AND the API) ----
POSTGRES_USER=tegaride
POSTGRES_PASSWORD=tegaride_dev_password
POSTGRES_DB=tegaride
DATABASE_URL=postgresql://tegaride:tegaride_dev_password@localhost:5432/tegaride?schema=public

# ---- Auth secrets (DEV ONLY placeholders) ----
# Generate real ones for any shared/production environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production if these still contain "dev-only".
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32chars-min

# ---- CORS: comma-separated list of allowed web origins ----
CORS_ORIGINS=http://localhost:5173
